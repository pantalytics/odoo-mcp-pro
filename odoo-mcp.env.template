# Copy to `odoo-mcp.env` on the server and fill in real values.
# Referenced by the compose service via `env_file`.

# --- Odoo connection (required) ---
ODOO_URL=https://your-odoo-instance.com
# Self-hosted Odoo requires an explicit database name.
# (Odoo.sh determines the DB by hostname — leave blank there.)
ODOO_DB=your_database

# --- Authentication: API key (recommended) OR user+password ---
ODOO_API_KEY=your_odoo_api_key
# ODOO_USER=admin
# ODOO_PASSWORD=your_password

# --- Transport (set here too so it works outside compose `environment:`) ---
ODOO_MCP_TRANSPORT=streamable-http
ODOO_MCP_HOST=0.0.0.0
ODOO_MCP_PORT=8000

# --- Optional tuning ---
ODOO_MCP_LOG_LEVEL=INFO
ODOO_MCP_DEFAULT_LIMIT=100
ODOO_MCP_MAX_LIMIT=500
ODOO_MCP_MAX_SMART_FIELDS=15
